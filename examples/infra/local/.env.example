# Copy to .env only if a default below collides with something already running.
# docker-compose.yml reads this file automatically.
#
# Postgres already defaults to 5433, off the usual 5432. The observability ports
# (3001, 9090, 4317 and 4318) are common defaults, so running another local
# stack that uses them at the same time needs them overridden here.

# POSTGRES_USER=kit
# POSTGRES_PASSWORD=secret
# POSTGRES_DB=kitdemo
# POSTGRES_PORT=5433

# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318

# Host directory Alloy tails for the service's JSON logs.
# KIT_LOG_DIR=/tmp/kit-logs

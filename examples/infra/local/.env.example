# Copy to .env only if a default below collides with something already running.
# docker-compose.yml reads this file automatically.
#
# Postgres already defaults to 5433 because freelance-tax-copilot holds 5432.
# nodeb8's local stack claims 3001, 9090, 4317 and 4318, so running that one at
# the same time needs the observability ports overridden here.

# POSTGRES_USER=kit
# POSTGRES_PASSWORD=secret
# POSTGRES_DB=kitdemo
# POSTGRES_PORT=5433

# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318

# Host directory Alloy tails for the service's JSON logs.
# KIT_LOG_DIR=/tmp/kit-logs
